/*
 * pipeline_fsm.sva — SVA properties for ibex pipeline state machine
 *
 * Bound to the DUT top via tb_top.sv bind statements.
 * Compiled with: vcs -assert enable_diag -assert coverage
 *
 * Properties:
 *   P1. After reset de-assertion, first instruction fetch within 4 cycles
 *   P2. Instruction grant responds within 3 cycles of request
 *   P3. No commit while reset is asserted
 *   P4. x0 register commit result must always be zero
 *   P5. commit_valid and trap_valid are mutually exclusive
 *   P6. Fetch address must be 4-byte aligned
 *   P7. PC monotonically advances (except on branch/trap)
 *   P8. No instruction grant without a prior request
 */

`ifndef PIPELINE_FSM_SVA
`define PIPELINE_FSM_SVA

module pipeline_fsm_checker (
  input logic        clk,
  input logic        rst_n,
  /* Instruction fetch */
  input logic        instr_req_o,
  input logic        instr_gnt_i,
  input logic [31:0] instr_addr_o,
  /* Commit port */
  input logic        commit_valid,
  input logic [4:0]  commit_rd,
  input logic [31:0] commit_result,
  input logic [31:0] commit_pc,
  /* Exception */
  input logic        trap_valid
);

  default clocking cb @(posedge clk); endclocking
  default disable iff (!rst_n);

  /* ── P1: First fetch within 4 cycles of reset ─────────────────
   * After rst_n rises, the DUT must begin fetching within 4 cycles. */
  property p_first_fetch_after_reset;
    $rose(rst_n) |-> ##[1:4] instr_req_o;
  endproperty
  ap_first_fetch: assert property (p_first_fetch_after_reset)
    else $error("[SVA P1] No instruction fetch within 4 cycles of reset de-assertion");
  cp_first_fetch: cover property (p_first_fetch_after_reset);

  /* ── P2: Grant latency ≤ 3 cycles ─────────────────────────────
   * Once req is asserted, gnt must follow within 3 cycles.
   * (TB drives gnt 0–3 cycles; this ensures DUT sees it.) */
  property p_gnt_latency;
    instr_req_o |-> ##[0:3] instr_gnt_i;
  endproperty
  ap_gnt_latency: assert property (p_gnt_latency)
    else $error("[SVA P2] instr_gnt not received within 3 cycles of req");
  cp_gnt_latency: cover property (p_gnt_latency);

  /* ── P3: No commit during reset ────────────────────────────────
   * Checked with separate disable — use !rst_n as the guard. */
  property p_no_commit_in_reset;
    @(posedge clk) !rst_n |-> !commit_valid;
  endproperty
  ap_no_commit_reset: assert property (p_no_commit_in_reset)
    else $error("[SVA P3] commit_valid asserted while rst_n = 0");

  /* ── P4: x0 writeback must always be zero ──────────────────────
   * BUG-001 target: if branch PC is wrong, execution may land on an
   * instruction that incorrectly writes x0. */
  property p_x0_always_zero;
    commit_valid && (commit_rd == 5'd0) |-> (commit_result == 32'd0);
  endproperty
  ap_x0_zero: assert property (p_x0_always_zero)
    else $error("[SVA P4] x0 written with non-zero value: %08h", commit_result);

  /* ── P5: commit and trap are mutually exclusive ─────────────── */
  property p_commit_trap_mutex;
    !(commit_valid && trap_valid);
  endproperty
  ap_commit_trap_mutex: assert property (p_commit_trap_mutex)
    else $error("[SVA P5] commit_valid and trap_valid simultaneously high");

  /* ── P6: Fetch address always 4-byte aligned ───────────────── */
  property p_fetch_aligned;
    instr_req_o |-> (instr_addr_o[1:0] == 2'b00);
  endproperty
  ap_fetch_aligned: assert property (p_fetch_aligned)
    else $error("[SVA P6] Unaligned fetch address: %08h", instr_addr_o);
  cp_fetch_aligned: cover property (p_fetch_aligned);

  /* ── P7: req stays high until grant (OBI requirement) ─────────
   * DUT must not drop req before receiving gnt. */
  property p_req_stable_until_gnt;
    instr_req_o && !instr_gnt_i |=> instr_req_o;
  endproperty
  ap_req_stable: assert property (p_req_stable_until_gnt)
    else $error("[SVA P7] instr_req dropped before instr_gnt");

  /* ── P8: gnt implies prior req ─────────────────────────────── */
  property p_gnt_requires_req;
    instr_gnt_i |-> instr_req_o;
  endproperty
  ap_gnt_req: assert property (p_gnt_requires_req)
    else $error("[SVA P8] instr_gnt asserted without instr_req");

  /* ── Coverage: commit after every N cycles ─────────────────── */
  property p_commits_happen;
    ##[1:100] commit_valid;
  endproperty
  cp_commits_happen: cover property (p_commits_happen);

endmodule : pipeline_fsm_checker

`endif // PIPELINE_FSM_SVA
